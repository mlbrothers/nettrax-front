    <script>
      function initRoiCalculator() {
        const root = document.getElementById("roi-calc");
        if (!root) return;

        const fleetSize = root.querySelector<HTMLInputElement>("#fleetSize")!;
        const fuelSpend = root.querySelector<HTMLInputElement>("#fuelSpend")!;
        const fleetSizeOut = root.querySelector("#fleetSizeOut")!;
        const fuelSpendOut = root.querySelector("#fuelSpendOut")!;
        const corridorButtons =
          root.querySelectorAll<HTMLButtonElement>(".corridor-btn");

        const monthlySavingsEl = root.querySelector("#monthlySavings")!;
        const savingsBasisEl = root.querySelector("#savingsBasis")!;
        const adminHoursEl = root.querySelector("#adminHours")!;
        const deadheadEl = root.querySelector("#deadhead")!;
        const annualBoostEl = root.querySelector("#annualBoost")!;

        let activeRate = 0.18;

        const zar = (n: number) => Math.round(n).toLocaleString("en-US");

        function updateSliderFill(input: HTMLInputElement) {
          const min = Number(input.min);
          const max = Number(input.max);
          const pct = ((Number(input.value) - min) / (max - min)) * 100;
          input.style.background = `linear-gradient(to right, #ff5a00 0%, #ff5a00 ${pct}%, #d7dde8 ${pct}%, #d7dde8 100%)`;
        }

        function recalculate() {
          const size = Number(fleetSize.value);
          const spend = Number(fuelSpend.value);

          const totalMonthlySpend = size * spend;
          const monthlySavings = totalMonthlySpend * activeRate;
          const annualBoost = monthlySavings * 12;
          const adminHours = size * 4;
          const deadheadReduction = (activeRate / 0.18) * 14.2;

          fleetSizeOut.textContent = `${size} Vehicles`;
          fuelSpendOut.textContent = `R ${zar(spend)}`;
          monthlySavingsEl.textContent = zar(monthlySavings);
          savingsBasisEl.textContent = `Based on ${(activeRate * 100).toFixed(1)}% routing optimization & elevation avoidances`;
          adminHoursEl.textContent = String(adminHours);
          deadheadEl.textContent = deadheadReduction.toFixed(1);
          annualBoostEl.textContent = zar(annualBoost);

          updateSliderFill(fleetSize);
          updateSliderFill(fuelSpend);
        }

        fleetSize.addEventListener("input", recalculate);
        fuelSpend.addEventListener("input", recalculate);

        corridorButtons.forEach((btn) => {
          btn.addEventListener("click", () => {
            corridorButtons.forEach((b) => {
              b.classList.remove(
                "border-brand-orange",
                "bg-white",
                "text-brand-orange",
              );
              b.classList.add(
                "border-transparent",
                "bg-white/70",
                "text-brand-muted",
              );
            });
            btn.classList.remove(
              "border-transparent",
              "bg-white/70",
              "text-brand-muted",
            );
            btn.classList.add(
              "border-brand-orange",
              "bg-white",
              "text-brand-orange",
            );

            activeRate = Number(btn.dataset.rate);
            recalculate();
          });
        });

        recalculate();
      }

      document.addEventListener("astro:page-load", initRoiCalculator);
      initRoiCalculator();
    </script>

